#!/bin/sh /etc/rc.common
# 网络面板项目配置；保留运行入口、依赖版本与安全边界。
START=95
STOP=10
USE_PROCD=1

boot() {
    config_load network_panel
    config_get_bool start_on_boot main boot_enabled 1
    [ "$start_on_boot" = 1 ] || return 0
    start
}

start_service() {
    [ ! -L /etc/wlmb-server ] || return 1
    mkdir -p /etc/wlmb-server || return 1
    chmod 700 /etc/wlmb-server || return 1
    config_load network_panel
    config_get backend_mode main backend_mode auto
    case "$backend_mode" in
        auto) server_mode=--serve-auto ;;
        standalone) server_mode=--serve-standalone ;;
        shared|legacy-readonly) server_mode=--serve-readonly ;;
        *) return 1 ;;
    esac
    procd_open_instance
    procd_set_param command /usr/sbin/wlmb-server "$server_mode"
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 90
    procd_close_instance
}
