{
  "service": "wlmb-server",
  "protocol": "NETWORK-PANEL-OPENWRT/1",
  "contractVersion": 1,
  "port": 1117,
  "pluginVersion": "1.0.7-r1",
  "backendLanguage": "Rust",
  "releaseStatus": "stable-private",
  "hardwareValidation": "capability-gated-not-universal-firmware-certification",
  "maxRequestBytes": 16384,
  "sessionSeconds": 1800,
  "endpoints": {
    "health": {"verb": "GET", "path": "/health", "auth": false, "params": [], "safeRetry": false, "implemented": true},
    "login": {"verb": "POST", "path": "/api/login", "auth": false, "params": ["username", "password"], "safeRetry": false, "implemented": true},
    "logout": {"verb": "POST", "path": "/api/logout", "auth": true, "params": [], "safeRetry": false, "implemented": true},
    "status": {"verb": "POST", "path": "/api/status", "auth": true, "params": ["modem"], "safeRetry": true, "implemented": true},
    "settings": {"verb": "POST", "path": "/api/settings", "auth": true, "params": [], "safeRetry": true, "implemented": true},
    "diagnostics": {"verb": "POST", "path": "/api/diagnostics", "auth": true, "params": [], "safeRetry": true, "implemented": true},
    "refresh": {"verb": "POST", "path": "/api/refresh", "auth": true, "params": ["modem"], "safeRetry": false, "implemented": true},
    "at_prepare": {"verb": "POST", "path": "/api/at_prepare", "auth": true, "params": ["modem", "command"], "safeRetry": false, "implemented": true, "requires": "verified-ready-endpoint"},
    "at_execute": {"verb": "POST", "path": "/api/at_execute", "auth": true, "params": ["modem", "command", "confirmation"], "safeRetry": false, "implemented": true, "requires": "one-use-instance-bound-confirmation"},
    "lock_status": {"verb": "POST", "path": "/api/lock_status", "auth": true, "params": ["modem", "force"], "safeRetry": false, "implemented": true, "requires": "model-platform-specific-typed-protocol"},
    "lock_prepare": {"verb": "POST", "path": "/api/lock_prepare", "auth": true, "params": ["modem", "operation"], "safeRetry": false, "implemented": true, "requires": "operation-specific-lock-capability"},
    "lock_execute": {"verb": "POST", "path": "/api/lock_execute", "auth": true, "params": ["modem", "operation", "revision", "confirmation"], "safeRetry": false, "implemented": true, "requires": "operation-specific-lock-capability"},
    "host_prepare": {"verb": "POST", "path": "/api/host_prepare", "auth": true, "params": ["operation"], "safeRetry": false, "implemented": true, "requires": "host-capability"},
    "host_execute": {"verb": "POST", "path": "/api/host_execute", "auth": true, "params": ["operation", "revision", "confirmation"], "safeRetry": false, "implemented": true, "requires": "host-capability"},
    "control_result": {"verb": "POST", "path": "/api/control_result", "auth": true, "params": ["job"], "safeRetry": true, "implemented": true},
    "sms_list": {"verb": "POST", "path": "/api/sms_list", "auth": true, "params": ["modem"], "safeRetry": true, "implemented": true, "requires": "standalone-or-compat-verified-sms-readonly"},
    "sms_read_state": {"verb":"POST","path":"/api/sms_read_state","auth":true,"params":["modem","id","unread"],"safeRetry":false,"implemented":true,"requires":"sms"},
    "sms_refresh": {"verb": "POST", "path": "/api/sms_refresh", "auth": true, "params": ["modem"], "safeRetry": false, "implemented": true, "requires": "standalone-or-compat-verified-sms-readonly"},
    "sms_settings_prepare": {"verb":"POST","path":"/api/sms_settings_prepare","auth":true,"params":["modem","enabled"],"safeRetry":false,"implemented":true,"requires":"verified-model-IMS-protocol,allowUnsafeAt"},
    "sms_settings_execute": {"verb":"POST","path":"/api/sms_settings_execute","auth":true,"params":["modem","enabled","confirmation"],"safeRetry":false,"implemented":true,"requires":"one-use-IMS-state-and-instance-bound-confirmation"},
    "sms_prepare": {"verb": "POST", "path": "/api/sms_prepare", "auth": true, "params": ["modem", "operation"], "safeRetry": false, "implemented": true, "requires": "smsSend-or-smsDelete,verified-standalone-or-shared-transaction-coordination"},
    "sms_execute": {"verb": "POST", "path": "/api/sms_execute", "auth": true, "params": ["modem", "operation", "confirmation"], "safeRetry": false, "implemented": true, "requires": "smsSend-or-smsDelete,one-use-instance-bound-confirmation"},
    "sms_forward_settings": {"verb": "POST", "path": "/api/sms_forward_settings", "auth": true, "params": [], "safeRetry": true, "implemented": true, "requires": "standalone-or-compat-verified-sms-readonly"},
    "sms_forward_configure": {"verb": "POST", "path": "/api/sms_forward_configure", "auth": true, "params": ["enabled", "modem", "pollSeconds", "token", "clearToken", "receiveEnabled"], "safeRetry": false, "implemented": true, "requires": "sms; pushplus-https only when forwarding is enabled; receiveEnabled is optional for legacy HTTP clients"}
  },
  "reservedFeatures": ["networkMode", "mlo"],
  "lockOperation": {"rat": ["NR", "NR_NSA", "LTE"], "mode": ["auto", "band", "cell"], "optionalTarget": "band", "notes": "NR_NSA is band preference only. Explicit target=band separates band reset from cell unlock. Missing firmware inventories and unknown reply variants fail closed. Read state has groups for cells, bandGroups for preferences, presets for refreshed inventories. Protocol mapping is not hardware acceptance."},
  "notes": "Capabilities are required; route presence is not hardware support. Host operations: wifi_edit, wifi_unify, device_block, traffic_limit. Long operations return a bounded owner-bound receipt; never replay execution after a disconnect. SIM switching is excluded. No arbitrary shell, serial or UCI path is accepted."
}
